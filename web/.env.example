# Copy to .env on the server. Never commit the real one.

PORT=3123
DEVICE_ID=esp32-home

# Shared secret the ESP32 sends as: Authorization: Bearer <token>
INGEST_TOKEN=change-me

# Realtime Database root. The /devices/<id>/status node must be world-readable.
FIREBASE_DB_URL=https://esp32-home-uptime-default-rtdb.firebaseio.com

# A heartbeat is due every 60s; this many seconds of silence opens an outage.
GAP_SECONDS=150

# Raw heartbeats older than this are pruned. Outages and events are kept forever.
RETAIN_DAYS=90

FIREBASE_POLL_MS=20000
DB_FILE=/home/ubuntu/apps/esphome-uptime/data/uptime.db

# Legacy database secret. Needed only so retention can DELETE - reads are public.
# Grants full access to the database; keep it out of git (this file is .env.example,
# the real values live in .env).
FIREBASE_DB_SECRET=

# Outage events in Firebase older than this are swept away every hour. SQLite on
# this box keeps the long-term record; Firebase only needs a recent window.
FIREBASE_RETAIN_DAYS=10
FIREBASE_PRUNE_MS=3600000
